{
  "schemaVersion": 1,
  "id": "fabric_mod_sync",
  "version": "${version}",
  "name": "Fabric Mod Sync",
  "description": "Consent-based exact mod synchronization with staged verification and automatic restart.",
  "authors": ["miniai-saka"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "server": ["io.github.miniai_saka.modsync.ModSyncServer"],
    "client": ["io.github.miniai_saka.modsync.client.ModSyncClient"]
  },
  "mixins": [{"config": "fabric-mod-sync.server.mixins.json", "environment": "server"}],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
